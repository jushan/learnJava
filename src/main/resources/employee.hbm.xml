<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
        <hibernate-mapping>
        <class name="com.duecat_java.advancejava.entity.Employee" table="employee">
        <id name="id" column="id">
        <generator class="identity"/>
        </id>
        <property name="name" column="name"/>
        <property name="age" column="age"/>
        <property name="gender" column="gender"/>
        <property name="department" column="department"/>
        <property name="salary" column="salary"/>
        <many-to-one name="address" class="com.duecat_java.advancejava.entity.Emp_address" column="address_id" cascade="all"/>
        </class>

        <query name="Employee.byName">
            <![CDATA[from com.duecat_java.advancejava.entity.Employee e where e.name = :name]]>
        </query>
        </hibernate-mapping>